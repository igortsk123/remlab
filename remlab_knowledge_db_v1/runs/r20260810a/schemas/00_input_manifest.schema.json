{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "remlab-kdb/00_input_manifest.schema.json",
 "title": "00_input_manifest",
 "type": "object",
 "required": [
  "artifact", "knowledge_base_id", "pipeline_version", "derived_schema_version",
  "run_id", "run_mode", "parent_state_snapshot_id", "parent_pipeline_state_sha256",
  "input_delta_manifest", "expected_input_manifest", "collection_input_completeness",
  "packages", "corpus_totals", "corpus_anomalies", "unresolved_packages"
 ],
 "properties": {
  "artifact": {"const": "00_input_manifest"},
  "knowledge_base_id": {"const": "REMLAB_INTERIOR_SOURCE_KB"},
  "run_id": {"type": "string", "minLength": 1},
  "run_mode": {"enum": ["BOOTSTRAP_FULL", "REBUILD_WITH_PRIOR_STATE", "INCREMENTAL_UPDATE"]},
  "parent_state_snapshot_id": {"type": ["string", "null"]},
  "parent_pipeline_state_sha256": {"type": ["string", "null"]},
  "input_delta_manifest": {"type": ["object", "null"]},
  "collection_input_completeness": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
  "packages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "logical_package_key", "artifact_uid", "package_content_uid",
     "content_identity_quality", "file_name", "file_sha256",
     "canonical_json_sha256", "chapter_number", "segment_identity",
     "source_document_id", "active_for_semantic_projection", "counts", "anomalies"
    ],
    "properties": {
     "logical_package_key": {"type": "string", "pattern": "^[A-Z0-9_]+::ch[0-9]{2}::p[0-9]{4}-[0-9]{4}$"},
     "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "canonical_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "content_identity_quality": {"enum": ["JCS", "RAW_FALLBACK"]},
     "chapter_number": {"type": "integer", "minimum": 1},
     "active_for_semantic_projection": {"type": "boolean"},
     "counts": {
      "type": "object",
      "required": ["records", "measurements", "evidence", "applicability_contexts",
                   "entities", "excluded_source_items", "chapter_review_queue"],
      "additionalProperties": {"type": "integer", "minimum": 0}
     },
     "anomalies": {"type": "array", "items": {
      "type": "object",
      "required": ["kind", "file", "detail"],
      "properties": {"kind": {"type": "string"}, "file": {"type": "string"},
                     "detail": {"type": "string"}}
     }}
    }
   }
  },
  "corpus_totals": {"type": "object", "additionalProperties": {"type": "integer"}},
  "corpus_anomalies": {"type": "array"},
  "unresolved_packages": {"type": "array"}
 }
}
