# ОБРАЗ ПРОБЫ Pixal3D (T-20261118-91; владелец TG 2092): ПОВЕРХ образа TRELLIS.2 с пинами (там уже torch 2.6/cu124, flash-attn 2.7.3, nvdiffrast, CuMesh, FlexGEMM, o-voxel, utils3d 0.0.2).
# Что добавляет: версии пакетов из requirements.txt Pixal3D (transformers 4.57.3 и др.), MoGe-2 (камера по картинке), natten 0.21.0 (нужен апсемплеру NAF; сборка CUDA под 8.9),
# код Pixal3D по закреплённому коммиту, NAF (код и веса — в кэше torch.hub по закреплённому коммиту, из интернета на старте не тянется).
# Веса Pixal3D (≈ 22 ГиБ), DINOv3 (закрытый, официальный репозиторий facebook/… по HF_TOKEN из env группы) и MoGe-2 (model.pt) — НЕ в образе, докачиваются на старте.
# ВАЖНО: апстрим жёстко берёт DINOv3 из зеркала `camenduru/dinov3-vitl16-pretrain-lvd1689m` — по правилу проекта зеркал DINOv3 не используем: заменяем на официальный репозиторий sed-ом.
ARG BASE=ghcr.io/igortsk123/mesh-trellis2-trial@sha256:d7beac21b04951697c3d86788ff580bfaa4f2498f97d822e6d281231b7112ad5
FROM ${BASE}
ARG PIXAL3D_COMMIT=f7cf38429b0bd264f1995f0f8743a88b1c728b94
ARG MOGE_COMMIT=74fbce054ebed49800de42d0ad0e83495065719a
ARG NAF_COMMIT=37f2dfc180f2de53d98bd601109c0da0dd6b0f43

# requirements.txt Pixal3D (pillow, gradio и git+MoGe — отдельно: pillow уже стоит, gradio не нужен)
RUN python3 -m pip install imageio==2.37.2 imageio-ffmpeg==0.6.0 tqdm==4.67.1 easydict==1.13 opencv-python-headless==4.12.0.88 trimesh==4.10.1 \
        transformers==4.57.3 zstandard==0.25.0 kornia==0.8.2 timm==1.0.22 diffusers==0.37.1 accelerate==1.13.0 plyfile==1.1.3 \
    && python3 -m pip install "git+https://github.com/microsoft/MoGe.git@${MOGE_COMMIT}"

# natten 0.21.0 — компиляция под RTX 4090 (sm_89); долго (десятки минут)
# сборке natten нужен cmake (в базе его нет — сборка 19.11 упала «Cannot find CMake executable»)
RUN python3 -m pip install cmake ninja \
    && NATTEN_CUDA_ARCH="8.9" NATTEN_N_WORKERS=4 python3 -m pip install natten==0.21.0 --no-build-isolation

RUN git clone https://github.com/TencentARC/Pixal3D.git /opt/Pixal3D \
    && cd /opt/Pixal3D && git checkout ${PIXAL3D_COMMIT} \
    && grep -rl "camenduru/dinov3-vitl16-pretrain-lvd1689m" /opt/Pixal3D --include=*.py --include=*.json | xargs -r sed -i 's#camenduru/dinov3-vitl16-pretrain-lvd1689m#facebook/dinov3-vitl16-pretrain-lvd1689m#g' \
    && ! grep -rn "camenduru/" /opt/Pixal3D --include=*.py --include=*.json     # остаться может только слово «camenduru» в комментарии, адреса зеркала быть не должно

# NAF: код по закреплённому коммиту и веса релиза — в кэше torch.hub (`torch.hub.load("valeoai/NAF", …, trust_repo=True)` берёт кэш без обращения к GitHub)
RUN mkdir -p /root/.cache/torch/hub/checkpoints \
    && git clone https://github.com/valeoai/NAF.git /root/.cache/torch/hub/valeoai_NAF_main \
    && git -C /root/.cache/torch/hub/valeoai_NAF_main checkout ${NAF_COMMIT} \
    && echo valeoai_NAF >> /root/.cache/torch/hub/trusted_list \
    && curl -fsSL -o /root/.cache/torch/hub/checkpoints/naf_release.pth https://github.com/valeoai/NAF/releases/download/model/naf_release.pth \
    && { echo "Pixal3D ${PIXAL3D_COMMIT}"; echo "MoGe ${MOGE_COMMIT}"; echo "NAF ${NAF_COMMIT}"; python3 -m pip freeze; } > /opt/BUILD_INFO_PIXAL3D.txt

COPY worker_trellis.py /app/worker_trellis.py
ENV MODEL=pixal3d PIXAL3D_DIR=/opt/Pixal3D ATTN_BACKEND=flash_attn
