# ОБРАЗ ПРОБЫ LocalMesh Engine (T-20261118-91; кандидат владельца, директор 19.11) — ОТДЕЛЬНЫЙ образ, на образ TRELLIS.2 не встаёт:
# движку нужны Python 3.12 и torch 2.8.0+cu128 ровно (расширения CUDA собираются под этот ABI), transformers 5.x — у образа TRELLIS.2 py3.10 / torch 2.6 / transformers 4.56.
# Что внутри: torch 2.8.0/cu128; три расширения CUDA ИЗ ИСХОДНИКОВ по закреплённым коммитам (CuMesh, FlexGEMM, o-voxel — ФОРКИ visualbruno; колёса автора и siraxe НЕ берём);
# движок localmesh-engine по коммиту; `plyfile` (GPL) удалён, как велит их INSTALL.md; nvdiffrast НЕ ставится (их растеризатор на PyTorch); natten не нужен (только одно фото).
# Веса (≈ 9,5 ГиБ + DINOv3 1,2 ГиБ) в образ НЕ входят — докачиваются воркером на старте. Вырезка фона BiRefNet_HR (`trust_remote_code`) отключена в воркере.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04
ARG LOCALMESH_COMMIT=32987f5966330f70dac19182be1d92ad760a8506
ARG TRELLIS_COMMIT=65d1e13b4a92296036044df0633242bb9e95abf6
ARG CUMESH_COMMIT=d10e54c30ddd03d11472c1431693f985501c7966
ARG FLEXGEMM_COMMIT=db388bd17c34abc697792aa718dca780734c2783
# 4060 Ti и 4090 — одна архитектура Ada (sm_89); сборка без видеокарты, поэтому архитектура и FORCE_CUDA заданы руками
ARG TORCH_CUDA_ARCH_LIST="8.9"
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} FORCE_CUDA=1 CUDA_HOME=/usr/local/cuda MAX_JOBS=4 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip git build-essential cmake ninja-build curl ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* && python3 --version \
    && python3 -m venv /opt/venv

RUN pip install --upgrade pip setuptools wheel packaging ninja \
    && pip install torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu128 \
    && python -c "import torch; print(torch.__version__, torch.version.cuda)"

# ФОРКИ visualbruno (автор ComfyUI-Trellis2, MIT; у них cumesh «1.0»): движку нужны `cumesh.remeshing.reconstruct_mesh_dc_quad` и `o_voxel.convert.tiled_flexible_dual_grid_to_mesh`, которых нет в
# JeffreyXiang/CuMesh и microsoft/TRELLIS.2 main (проверено живым запуском 19.11: lm0 — tiled…, lm3 — reconstruct_mesh_dc_quad).
# три расширения CUDA: --recursive обязателен (o-voxel тянет Eigen подмодулем), --no-build-isolation — чтобы собирались против НАШЕГО torch
RUN git clone --recursive https://github.com/visualbruno/CuMesh.git /tmp/ext/CuMesh && git -C /tmp/ext/CuMesh checkout ${CUMESH_COMMIT} && git -C /tmp/ext/CuMesh submodule update --init --recursive \
    && pip install --no-build-isolation /tmp/ext/CuMesh
RUN git clone --recursive https://github.com/visualbruno/FlexGEMM.git /tmp/ext/FlexGEMM && git -C /tmp/ext/FlexGEMM checkout ${FLEXGEMM_COMMIT} && git -C /tmp/ext/FlexGEMM submodule update --init --recursive \
    && pip install --no-build-isolation /tmp/ext/FlexGEMM
RUN git clone --recursive https://github.com/visualbruno/TRELLIS.2.git /tmp/ext/TRELLIS.2 && git -C /tmp/ext/TRELLIS.2 checkout ${TRELLIS_COMMIT} && git -C /tmp/ext/TRELLIS.2 submodule update --init --recursive \
    && pip install --no-build-isolation /tmp/ext/TRELLIS.2/o-voxel \
    && rm -rf /tmp/ext

RUN git clone https://github.com/Quentincls/localmesh-engine.git /opt/localmesh-engine && git -C /opt/localmesh-engine checkout ${LOCALMESH_COMMIT} \
    && pip install -e /opt/localmesh-engine \
    && pip uninstall -y plyfile \
    && { python -c "import cumesh, flex_gemm; print('extensions ok')" || echo 'ПРЕДУПРЕЖДЕНИЕ: импорт расширений без видеокарты не прошёл (проверка — на живой машине)'; }

RUN { echo "localmesh-engine ${LOCALMESH_COMMIT}"; echo "TRELLIS.2 ${TRELLIS_COMMIT}"; echo "CuMesh ${CUMESH_COMMIT}"; echo "FlexGEMM ${FLEXGEMM_COMMIT}"; pip freeze; } > /opt/BUILD_INFO_LOCALMESH.txt

COPY worker_trellis.py /app/worker_trellis.py
ENV MODEL=localmesh
WORKDIR /app
CMD ["python3", "/app/worker_trellis.py"]
