# ОБРАЗ ПРОБЫ TRELLIS.2-4B ДЛЯ SALAD (T-20261118-91). Тег — в существующий пакет `ghcr.io/igortsk123/mesh-hunyuan:trellis2-trial`
# (токен DEV новый пакет создать не может). Боевые группы закреплены по digest — этот тег их не затрагивает.
#
# ЧТО ВНУТРИ. CUDA 12.4.1 devel (расширения собираются nvcc, а `nvdiffrast` компилирует плагин при первом вызове — devel нужен и в рантайме),
# Python 3.10, torch 2.6.0 cu124 — ровно как `setup.sh` апстрима (`--new-env`: python 3.10 + torch 2.6.0/cu124). Сборка БЕЗ видеокарты: `setup.sh`
# без nvidia-smi завершается ошибкой, поэтому его шаги выполнены руками, с `TORCH_CUDA_ARCH_LIST=8.9` (RTX 4090, Ada) и `FORCE_CUDA=1`.
# Версии зафиксированы по коммитам на 18.11 (ARG ниже); сами хеши пишутся в /opt/BUILD_INFO.txt — попадут в паспорт замера.
# ВЕСА НЕ ВШИТЫ: `microsoft/TRELLIS.2-4B` (16,2 ГБ) качается при старте ноды с Hugging Face — это и есть замер холодного старта (для пробы; боевую
# очередь с невшитыми весами не повторяем, ADR-0137). Закрытая DINOv3 — по `HF_TOKEN` из переменных окружения группы (в образ не попадает).
# Модуль вырезки фона RMBG-2.0 (закрытый, некоммерческий) воркер заменяет заглушкой — вход обязан быть RGBA (см. worker_trellis.py).
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ARG TRELLIS_COMMIT=75fbf0183001ed9876c8dbb35de6b68552ee08bd
ARG NVDIFFRAST_REF=v0.4.0
ARG NVDIFFREC_REF=renderutils
ARG UTILS3D_COMMIT=9a4eb15e4021b67b12c460c7057d642626897ec8
ARG TORCH_CUDA_ARCH_LIST="8.9"

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} FORCE_CUDA=1 CUDA_HOME=/usr/local/cuda MAX_JOBS=4 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt NVIDIA_DRIVER_CAPABILITIES=all

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-pip python3-wheel git ca-certificates curl ninja-build libjpeg-dev libgl1 libglib2.0-0 libopenexr-dev \
    && rm -rf /var/lib/apt/lists/* && python3 --version

RUN python3 -m pip install --upgrade pip setuptools wheel packaging \
    && python3 -m pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124

# basic из setup.sh (без gradio и sudo; pillow-simd заменён обычным pillow — тот же интерфейс)
RUN python3 -m pip install imageio imageio-ffmpeg tqdm easydict opencv-python-headless trimesh transformers tensorboard pandas lpips zstandard \
        kornia timm pillow huggingface_hub \
    && python3 -m pip install git+https://github.com/EasternJournalist/utils3d.git@${UTILS3D_COMMIT}

# flash-attn 2.7.3 (по умолчанию — готовое колесо под torch 2.6/cu12; если не нашлось, соберётся из исходников — долго)
RUN python3 -m pip install flash-attn==2.7.3 --no-build-isolation

RUN git clone https://github.com/microsoft/TRELLIS.2.git --recursive /opt/TRELLIS.2 \
    && cd /opt/TRELLIS.2 && git checkout ${TRELLIS_COMMIT} && git submodule update --init --recursive

# расширения с CUDA — в порядке setup.sh; хеши коммитов — в BUILD_INFO.txt
RUN mkdir -p /tmp/extensions \
    && git clone -b ${NVDIFFRAST_REF} https://github.com/NVlabs/nvdiffrast.git /tmp/extensions/nvdiffrast \
    && python3 -m pip install /tmp/extensions/nvdiffrast --no-build-isolation \
    && git clone -b ${NVDIFFREC_REF} https://github.com/JeffreyXiang/nvdiffrec.git /tmp/extensions/nvdiffrec \
    && python3 -m pip install /tmp/extensions/nvdiffrec --no-build-isolation \
    && git clone https://github.com/JeffreyXiang/CuMesh.git /tmp/extensions/CuMesh --recursive \
    && python3 -m pip install /tmp/extensions/CuMesh --no-build-isolation \
    && git clone https://github.com/JeffreyXiang/FlexGEMM.git /tmp/extensions/FlexGEMM --recursive \
    && python3 -m pip install /tmp/extensions/FlexGEMM --no-build-isolation \
    && cp -r /opt/TRELLIS.2/o-voxel /tmp/extensions/o-voxel \
    && python3 -m pip install /tmp/extensions/o-voxel --no-build-isolation \
    && { for d in nvdiffrast nvdiffrec CuMesh FlexGEMM; do echo "$d $(git -C /tmp/extensions/$d rev-parse HEAD)"; done; \
         echo "TRELLIS.2 ${TRELLIS_COMMIT}"; python3 -m pip freeze | grep -i -E '^(torch|flash|transformers|trimesh|o-voxel|nvdiffrast|cumesh|flexgemm)' ; } > /opt/BUILD_INFO.txt \
    && rm -rf /tmp/extensions

COPY worker_trellis.py /app/worker_trellis.py
WORKDIR /app
ENV TRELLIS_DIR=/opt/TRELLIS.2 MODEL=trellis2 PORT=8000 HF_HOME=/data/hf OUT_DIR=/data/out
EXPOSE 8000
CMD ["python3", "/app/worker_trellis.py"]
