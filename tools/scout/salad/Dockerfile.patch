# ТОНКИЙ СЛОЙ КОДА поверх боевого образа: только наши файлы из /app, веса и апстрим не трогаем.
#
# ЗАЧЕМ (04.09, план mesh-pool-hardening P1-7 — ОДНА пересборка вместо трёх):
#  - preprocess.fetch: 3 повтора с паузами 2/5/10 с на сетевых сбоях (за сутки 03.09 — 27
#    отказов сети, 10 таймаутов, 6 SSL EOF на входе, каждый без единой повторной попытки),
#    404/410 не повторяем; браузерный UA; кэш байтов — фото не качается второй раз ради source.jpg;
#  - worker: phase warming|ready|failed, warm=False при провале прогрева (раньше в finally
#    ставился True, и «тёплая» нода с мёртвыми моделями стояла оплаченной часами), GET /ready,
#    inflight по job_id + GET /job/<id> — защита от двойного /generate после обрыва SSH;
#  - storage: SinkError со стадией и HTTP-кодом — отправитель судит по стадии, не по тексту EOF;
#  - pipeline: cut_alien_debris возвращает итог в manifest (gpu.alien), зовётся для любого glb.
#
# Смена образа = новая группа (PATCH образа у живой группы молчит, ADR-0154), по одной группе
# в окно 15:00 UTC — batch и так гаснут кроном.
#   docker build -f Dockerfile.patch --build-arg BASE=ghcr.io/igortsk123/mesh-hunyuan:cu124-localpaint \
#                -t ghcr.io/igortsk123/mesh-hunyuan:cu124-localpaint2 .
ARG BASE
FROM ${BASE}
COPY preprocess.py pipeline.py storage.py worker.py /app/
# Проверка на месте сборки: молчаливо не скопировавшийся файл дал бы образ, неотличимый от старого.
RUN python -c "import ast,sys; [ast.parse(open(f'/app/{m}.py').read()) for m in ('preprocess','pipeline','storage','worker')]" && \
    grep -q "def ready" /app/worker.py && grep -q "FETCH_RETRIES" /app/preprocess.py && \
    grep -q "class SinkError" /app/storage.py && grep -q "'alien': alien" /app/pipeline.py && \
    echo "слой кода на месте: /ready, повторы фото, SinkError, alien"
