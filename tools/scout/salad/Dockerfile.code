# ТОНКИЙ СЛОЙ КОДА поверх готового боевого образа с весами.
#
# ЗАЧЕМ. Код копируется в БАЗОВЫЙ образ (Dockerfile, последний слой), а боевой `cu124-baked`
# собирается поверх базового и докачивает ~28 ГБ весов (Dockerfile.weights). Значит правка
# одной строки в `pipeline.py` по обычному пути означала бы: пересобрать базу → сменился
# digest → веса качаются заново → часы. При том, что сами веса не изменились ни на байт.
#
# Здесь мы берём ЗА ОСНОВУ уже собранный боевой образ и кладём поверх только .py-файлы.
# Сборка — секунды, пуш — один маленький слой (веса уже в реестре).
#
# ПОЧЕМУ FROM ЗАДАЁТСЯ ARG'ом, а не константой: основа должна быть тем самым digest'ом,
# который СЕЙЧАС крутится в боевой группе. Зашитый тег молча увёл бы нас на другой образ.
#
#   docker build -f Dockerfile.code --build-arg BASE=<digest> -t <repo>:<tag> .
ARG BASE
FROM ${BASE}

# Тот же список файлов, что и в базовом образе (Dockerfile, COPY ... /app/): расхождение
# означало бы, что часть кода на ноде осталась старой, а часть новая.
COPY manifest.py preprocess.py hybrid_mask.py pipeline.py storage.py worker.py fetch_weights.py /app/
