{
 "name": "mesh-pool",
 "display_name": "mesh-pool",
 "container": {
  "image": "ghcr.io/igortsk123/mesh-hunyuan:cu124",
  "resources": {
   "cpu": 4,
   "memory": 16384,
   "gpu_classes": [
    "ed563892-aacd-40f5-80b7-90c9be6c759b"
   ],
   "storage_amount": 53687091200
  },
  "environment_variables": {
   "STORAGE_BACKEND": "http",
   "MESH_SINK_URL": "https://remont-lab.online/mesh-sink",
   "MESH_SINK_TOKEN": "<MESH_SINK_TOKEN>",
   "STAGED": "1",
   "PIPELINE_VERSION": "v1"
  },
  "registry_authentication": {
   "basic": {
    "username": "igortsk123",
    "password": "<GHCR_TOKEN>"
   }
  },
  "image_caching": true
 },
 "autostart_policy": true,
 "restart_policy": "always",
 "replicas": 5,
 "country_codes": [],
 "readiness_probe": {
  "http": {
   "path": "/health",
   "port": 8000,
   "scheme": "http",
   "headers": []
  },
  "initial_delay_seconds": 120,
  "period_seconds": 30,
  "timeout_seconds": 10,
  "success_threshold": 1,
  "failure_threshold": 10
 },
 "networking": {
  "protocol": "http",
  "port": 8000,
  "auth": true,
  "load_balancer": "round_robin",
  "single_connection_limit": false,
  "client_request_timeout": 1200,
  "server_response_timeout": 1200
 }
}