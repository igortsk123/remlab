{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "catalog-item.schema.json",
 "title": "CatalogItem",
 "description": "Товар каталога комнаты — выход адаптера tools/scout/catalog_items.py (room-pipeline-01 Б-1, T-20261105-39). Проверка — catalog_items.schema_errors (верхний уровень: типы, enum, обязательные ключи вложенных).",
 "type": "object",
 "additionalProperties": false,
 "required": ["offer_id", "origin", "room_type", "roles", "mid", "eid", "name", "shop", "brand", "price", "in_stock", "url",
              "url_direct", "dims", "photo", "style", "asset", "params", "flags", "family"],
 "properties": {
  "offer_id": {"type": "string", "description": "shop_mid:external_id (= sku asset_revisions)"},
  "origin": {"type": "string", "enum": ["products", "room_catalog"]},
  "room_type": {"type": "string", "enum": ["living", "bedroom"]},
  "roles": {"type": "array", "description": "роли товара в комнате, порядок появления; товар в двух ролях — один элемент"},
  "mid": {"type": "integer"},
  "eid": {"type": "string"},
  "name": {"type": ["string", "null"]},
  "shop": {"type": ["string", "null"]},
  "brand": {"type": ["string", "null"]},
  "price": {"type": ["number", "null"], "description": "руб."},
  "in_stock": {"type": ["boolean", "null"], "description": "room_catalog: null — наличие по свежести фида (missing_runs)"},
  "url": {"type": ["string", "null"], "description": "ссылка фида как есть"},
  "url_direct": {"type": ["string", "null"], "description": "products: прямая ссылка магазина"},
  "dims": {"type": "object", "required": ["w", "d", "h", "len", "dia", "sleep_w", "sleep_l", "source", "footprint_ok", "note", "h_evidence"],
           "description": "см; source — products.dims_source; footprint_ok и note — room_catalog; h_evidence — products.dims_evidence.h"},
  "photo": {"type": "object", "required": ["url", "url_hd", "best", "alive", "revision"],
            "description": "best = hd, иначе обычное; revision — null до волны В (photo_hash)"},
  "style": {"type": ["object", "null"], "description": "баллы стилей 0–10"},
  "asset": {"type": "object", "required": ["mesh_status", "mesh_url", "revision", "defect"],
            "description": "revision ready|generated|null и defect — только при with_assets, иначе null"},
  "params": {"type": "object", "description": "ключи catalog_items.PARAM_KEYS (products)"},
  "flags": {"type": "object", "description": "признаки по описанию товара (desc_flags)"},
  "family": {"type": ["string", "null"], "description": "магазин|модель (room_catalog.family) — ключ оценки стиля семейства"}
 }
}
