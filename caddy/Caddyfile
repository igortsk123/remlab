{
	email admin@remont-lab.online
	# Let's Encrypt (prod). Челлендж пройдёт по TLS-ALPN-01 на :443 (порт :80 закрыт снаружи).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

remont-lab.online {
	encode zstd gzip

	# служебные страницы проверки (витрина шаблонов, галереи, отчёты) — статик из
	# /opt/remlab/test. БЫЛО ТОЛЬКО НА СЕРВЕРЕ: репо-версия затирала блок при
	# деплое (урок 07.08) — сведено 11.08.
	# Приёмник 3D-мешей с нод SaladCloud (28.08). Ноды одноразовые: результат надо унести
	# сразу, иначе он умрёт вместе с нодой. Сервис — на хосте, слушает шлюз docker-сети,
	# контейнера к хосту), портов наружу не публикует; авторизация токеном внутри приёмника.
	handle_path /mesh-sink/* {
		reverse_proxy mesh-receiver:8770 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
		request_body {
			max_size 100MB
		}
		header X-Robots-Tag "noindex, nofollow"
	}

	# ДЕМО ДЛЯ ПАРТНЁРА (08.09, план demo-permalink). Переехало из служебной /test/buildup:
	# у демо теперь свой адрес и своя папка (`./demo` → /srv/demo), в общем списке /test/ его нет.
	# Кэш по типам: картинки и спрайты (98 % веса — 74 МБ видов сверху) живут неделю, поэтому со
	# второго захода демо открывается почти мгновенно; страница, данные и скрипты — БЕЗ кэша,
	# иначе после публикации у партнёра осталась бы старая вёрстка с новыми данными.
	redir /demo /demo/ 301
	handle_path /demo/* {
		root * /srv/demo
		@img path *.png *.jpg *.jpeg *.webp *.gif *.svg *.woff2 *.ico
		header @img Cache-Control "public, max-age=604800"
		@live not path *.png *.jpg *.jpeg *.webp *.gif *.svg *.woff2 *.ico
		header @live Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
		header X-Robots-Tag "noindex, nofollow"
	}

	# Старый служебный адрес демо закрыт наглухо (решение владельца 08.09): ссылка могла разойтись,
	# нового адреса эта заглушка не показывает. 410 — «страницы больше нет», не временная ошибка.
	handle /test/buildup* {
		header Content-Type "text/html; charset=utf-8"
		header X-Robots-Tag "noindex, nofollow"
		respond "<!doctype html><meta charset=utf-8><title>Страница закрыта</title><body style=\"font:16px system-ui;padding:40px\">Страница закрыта.</body>" 410
	}

	# Модели и постеры для ручной приёмки мешей (/lab/mesh-audit, план mesh-owner-audit):
	# в отличие от /test/* — С КЭШЕМ. Каталог партии и имя постера содержат хеш/токен, файлы
	# неизменяемы; без кэша 20 моделей по 7,6 МБ качались бы заново при каждом возврате на страницу.
	handle_path /test/mesh-audit/* {
		root * /srv/test/mesh-audit
		file_server
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, max-age=604800, immutable"
	}

	handle_path /test/* {
		root * /srv/test
		file_server browse
		header X-Robots-Tag "noindex, nofollow"
		# страницы обновляются часто, владелец открывает БЕЗ ?v — кэш запрещаем,
		# иначе он видит прошлую версию (правило владельца 11.08)
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		header Pragma "no-cache"
	}

	# Черновой рендер комнаты (26.08): ключ fal только на сервере, поэтому страница ходит сюда.
	# Наружу отдаём лишь два метода; сервис сам держит лимит расхода.
	handle /api/draft* {
		reverse_proxy draft:8099
	}
	handle /api/warm* {
		reverse_proxy draft:8099
	}
	handle /api/render* {
		reverse_proxy draft:8099
	}
	# опрос фоновых заданий рендера (01.09): длинный запрос больше не держит соединение
	handle /api/job* {
		reverse_proxy draft:8099
	}
	handle /api/share* {
		reverse_proxy draft:8099
	}

	reverse_proxy remlab-app:3000
}
