{
	email admin@remont-lab.online
	# Let's Encrypt (prod). Челлендж пройдёт по TLS-ALPN-01 на :443 (порт :80 закрыт снаружи).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ПЕРЕЗАПУСК ПРИ ВЫКЛАДКЕ (T-20261106-66): каждая выкладка пересоздаёт контейнеры app/draft — 5–10 с имени в сети нет
# или порт ещё не слушает, и Caddy отвечал 502 (60 окон за сутки 05–06.11). Теперь запрос ждёт новый контейнер до 15 с.
# Caddy 2.8 повторяет при ошибке соединения (запрос не ушёл) любой метод, после отправки — только GET. Но тело POST
# транспорт Go закрывает уже на неудачной попытке: без буфера повтор POST падает «invalid Read on closed Body» (проба
# 06.11). Поэтому request_buffers 1MB — тело до 1 МБ держится в памяти и уходит заново целым; больше 1 МБ — без
# повтора, как раньше (POST к app/draft за 72 ч — до 0,3 МБ; крупные загрузки — /mesh-sink, там повтора нет).
(retry_restart) {
	lb_try_duration 15s
	lb_try_interval 250ms
	request_buffers 1MB
}

remont-lab.online {
	encode zstd gzip

	# ЖУРНАЛ ОБРАЩЕНИЙ — ВРЕМЕННО (инцидент 08.09): ловим запрос, которым в контейнер
	# приложения попадают чужие команды. Убрать после разбора.
	log {
		output stdout
		# Секреты и ключи-ссылки в журнал не пишем (b2b-02, verify 13.10): заголовки с ключами
		# вырезаются, токены ссылок покупателей в адресах и Referer заменяются на «…».
		format filter {
			wrap json
			fields {
				request>headers>X-Manager-Key delete
				request>headers>X-Partner-Key delete
				request>headers>X-Internal-Token delete
				request>headers>X-Trace-Token delete
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				# ключ наших машин для пробы (`lib/trial/own-key.ts`, T-20261110-24)
				request>headers>X-Trial-Own-Key delete
				request>headers>Referer delete
				request>uri regexp "([?&]s=|/api/sends/|/api/collections/|/api/trial/|/api/trial/worker/|/try/)[A-Za-z0-9_-]{22}" "${1}…"
			}
		}
	}

	# ЗАЩИТНЫЕ ЗАГОЛОВКИ НА ВЕСЬ САЙТ (план b2b-01, ADR-0256).
	# frame-ancestors — КТО может показать нас внутри своей страницы (iframe). Без него любой сайт
	# мог встроить демо под чужим брендом. По умолчанию — только мы сами; домены застройщика для встраивания живут
	# в реестре партнёров (`frameDomains`), заголовок с ними ставит страница `/embed/…` (b2b-07). Полную CSP НЕ ставим: она сломала бы three.js, PostHog и
	# Метрику, а от встраивания защищает именно эта директива. X-Frame-Options не ставим —
	# он не умеет список доменов, а современные браузеры всё равно слушают frame-ancestors.
	header {
		defer
		# «?» — только если приложение не поставило своё: страница встраивания (`/embed/…`, b2b-07) ставит
		# frame-ancestors с доменами партнёра. ПРАВИЛО: любой ответ со своим CSP обязан содержать frame-ancestors.
		?Content-Security-Policy "frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# «?» ОТДЕЛЬНОЙ директивой (09.11, agent-trial-01): ручки пробы ставят свой `no-referrer` — ключ ссылки /try/<id> не
	# уходит в Referer чужим сайтам; остальным ответам — по-прежнему strict-origin-when-cross-origin. В общем блоке выше
	# нельзя: Caddy сводит все «?» блока в ОДНО условие «нет ни того, ни другого» — ответ со своим Referrer-Policy терял бы
	# frame-ancestors (проверено `caddy adapt`).
	header ?Referrer-Policy "strict-origin-when-cross-origin"

	# ПРОБА ДЛЯ АГЕНТОВ (agent-trial-01): страница задания /try/<id> — ключ в адресе. Не в кэши, не в Referer, не в поиск.
	# Порядок двух отложенных header не важен: здесь — безусловная установка, общий блок выше — только «если нет».
	@trialpage path /try /try/*
	header @trialpage {
		defer
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
	}
	# КЭШ ПРОБЫ (T-20261110-43): тур `/try/<id>/tour…` решает сам (`lib/trial/tour-cache.ts`) — без ключа агента хранить со сверкой
	# (`private, no-cache` + ETag, повторное открытие — 304 без тела), с ключом `k` и всё прочее — `private, no-store`; ответ тура без
	# своего Cache-Control — «не хранить». Остальное /try — безусловно «не хранить», как было. «?» — отдельной директивой (см. выше).
	@trialstrict {
		path /try /try/*
		not path_regexp ^/try/[A-Za-z0-9_-]+/tour(?:/.*)?$
	}
	header @trialstrict {
		defer
		Cache-Control "private, no-store"
	}
	@trialtour path_regexp ^/try/[A-Za-z0-9_-]+/tour(?:/.*)?$
	header @trialtour ?Cache-Control "private, no-store"

	# ВНУТРЕННИЕ РУЧКИ ПРИЛОЖЕНИЯ (план b2b-01): их зовут только соседние контейнеры по сети
	# remlab-net (сервис кадров кладёт заявку «отправить себе» в базу). Снаружи — как будто их нет.
	handle /api/internal/* {
		respond 404
	}

	# ЗАСЛОН ОТ ЭКСПЛОЙТА СЕРВЕРНЫХ ДЕЙСТВИЙ NEXT.JS (инцидент 08.09). Настоящее серверное
	# действие присылает в `Next-Action` хеш (40–64 hex); эксплойт шлёт «x» и произвольный
	# путь. Временно, до обновления Next.js — тогда убрать.
	@nextrce {
		header Next-Action *
		not header_regexp Next-Action ^[0-9a-fA-F]{40,64}$
	}
	handle @nextrce {
		respond "Запрос отклонён." 403
	}

	# Загрузка плана и мост воркера DEV (agent-trial-01). Не /api/job*: тот префикс уходит в сервис кадров draft:8099
	# (совпал бы и /api/jobs). Тело ≤ 16 МБ — внешний заслон; файл ≤ 15 МБ считает само приложение по прочитанным байтам
	# (потоком на диск, не в память — app живёт в 1 ГБ). Буфер повтора retry_restart — 1 МБ: большая загрузка при
	# перезапуске app не повторяется, а получает 502 (агент загрузит снова). Именованный матчер (не путь) — чтобы
	# Caddy не поднял блок выше заслона @nextrce: запрос с Next-Action сюда не попадает вовсе.
	@trialapi {
		path /api/trial /api/trial/*
		not header Next-Action *
	}
	handle @trialapi {
		request_body {
			max_size 16MB
		}
		reverse_proxy remlab-app:3000 {
			import retry_restart
		}
	}

	# служебные страницы проверки (витрина шаблонов, галереи, отчёты) — статик из
	# /opt/remlab/test. БЫЛО ТОЛЬКО НА СЕРВЕРЕ: репо-версия затирала блок при
	# деплое (урок 07.08) — сведено 11.08.
	# Приёмник 3D-мешей с нод SaladCloud (28.08). Ноды одноразовые: результат надо унести
	# сразу, иначе он умрёт вместе с нодой. Сервис — на хосте, слушает шлюз docker-сети,
	# контейнера к хосту), портов наружу не публикует; авторизация токеном внутри приёмника.
	handle_path /mesh-sink/* {
		reverse_proxy mesh-receiver:8770 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
		request_body {
			max_size 100MB
		}
		header X-Robots-Tag "noindex, nofollow"
	}

	# ДЕМО ДЛЯ ПАРТНЁРА (08.09, план demo-permalink). Переехало из служебной /test/buildup:
	# у демо теперь свой адрес и своя папка (`./demo` → /srv/demo), в общем списке /test/ его нет.
	# Кэш по типам: картинки и спрайты (98 % веса — 74 МБ видов сверху) живут неделю, поэтому со
	# второго захода демо открывается почти мгновенно; страница, данные и скрипты — со сверкой каждый раз
	# (no-cache, не max-age), иначе после публикации у партнёра осталась бы старая вёрстка с новыми данными.
	redir /demo /demo/ 301
	handle_path /demo/* {
		root * /srv/demo
		@img path *.png *.jpg *.jpeg *.webp *.gif *.svg *.woff2 *.ico
		header @img Cache-Control "public, max-age=604800"
		# страница, данные, скрипты — хранить со сверкой (T-20261110-43): каждое открытие спрашивает сервер по ETag (file_server),
		# не изменилось — 304 без тела, после публикации — новое тело; свежесть та же, что у no-store, повтор не качает 450 КБ заново
		@live not path *.png *.jpg *.jpeg *.webp *.gif *.svg *.woff2 *.ico
		header @live Cache-Control "no-cache"
		# ЗАРАНЕЕ СЖАТЫЕ КОПИИ (T-20261110-43/2): публикация кладёт рядом с текстами `.br` (brotli 11) и `.gz` (gzip 9,
		# `tools/scout/precompress.mjs`); file_server отдаёт копию по Accept-Encoding (br, иначе gzip) со своим ETag и
		# `Vary: Accept-Encoding`, `encode` выше уже сжатое не пережимает. Разметка 411 → 290 КБ, данные 161 → 99 КБ против
		# сжатия на лету (−0,7 с до первой карточки на 2 Мбит/с). Копии нет — как раньше, сжатие на лету.
		file_server {
			precompressed br gzip
		}
		header X-Robots-Tag "noindex, nofollow"
	}

	# Старый служебный адрес демо закрыт наглухо (решение владельца 08.09): ссылка могла разойтись,
	# нового адреса эта заглушка не показывает. 410 — «страницы больше нет», не временная ошибка.
	handle /test/buildup* {
		header Content-Type "text/html; charset=utf-8"
		header X-Robots-Tag "noindex, nofollow"
		respond "<!doctype html><meta charset=utf-8><title>Страница закрыта</title><body style=\"font:16px system-ui;padding:40px\">Страница закрыта.</body>" 410
	}

	# Модели и постеры для ручной приёмки мешей (/lab/mesh-audit, план mesh-owner-audit):
	# в отличие от /test/* — С КЭШЕМ. Каталог партии и имя постера содержат хеш/токен, файлы
	# неизменяемы; без кэша 20 моделей по 7,6 МБ качались бы заново при каждом возврате на страницу.
	# Лёгкие 3D-модели конфигуратора квартиры (/flat, план apartment-3d-configurator):
	# файл модели неизменяем (пересборка кладёт НОВОЕ имя), поэтому кэшируем надолго —
	# иначе комната перекачивается на каждый заход. Парный redir обязателен: handle_path
	# без него даёт 404 на адрес без слэша (урок 430).
	redir /rt /rt/ 301
	handle_path /rt/* {
		root * /srv/test/rt
		file_server
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, max-age=604800, immutable"
	}

	handle_path /test/mesh-audit/* {
		root * /srv/test/mesh-audit
		file_server
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, max-age=604800, immutable"
	}

	# ЗАКРЫТО 13.10 (Fable): очередь отправки подборок демо хранит контакты людей (телефон/Telegram),
	# а /test/* отдаётся с browse. Папку снаружи не показываем — ни список, ни файлы.
	@sharequeue path /test/share/_queue /test/share/_queue/*
	handle @sharequeue {
		respond 404
	}

	# МОДЕЛИ 3D ДЕМО (b2b-12): из общего /test/* шли с no-store — 7 моделей ≈ 30 МБ на КАЖДЫЙ вход в 3D.
	# no-cache = браузер хранит файл и перепроверяет по ETag (ответ 304 без тела): свежесть та же, повторной закачки нет.
	handle_path /test/mesh-pilot10/* {
		root * /srv/test/mesh-pilot10
		file_server browse
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, no-cache"
	}

	# КАДРЫ ДЕМО (T-20261110-43): фото карточек /demo — из общего /test/* шли с no-store, повторное открытие качало кадр
	# главной заново (на компьютере 2048 px ≈ 460 КБ). Имена кадров уникальны; no-cache — хранить и сверять по ETag (304
	# без тела), удалённый кадр — 404, как и раньше. Остальное /test — как было (ниже).
	handle_path /test/share/frames/* {
		root * /srv/test/share/frames
		file_server browse
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "public, no-cache"
	}

	handle_path /test/* {
		root * /srv/test
		file_server browse
		header X-Robots-Tag "noindex, nofollow"
		# страницы обновляются часто, владелец открывает БЕЗ ?v — кэш запрещаем,
		# иначе он видит прошлую версию (правило владельца 11.08)
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		header Pragma "no-cache"
	}

	# Черновой рендер комнаты (26.08): ключ fal только на сервере, поэтому страница ходит сюда.
	# Наружу отдаём лишь два метода; сервис сам держит лимит расхода.
	handle /api/draft* {
		reverse_proxy draft:8099 {
			import retry_restart
		}
	}
	handle /api/warm* {
		reverse_proxy draft:8099 {
			import retry_restart
		}
	}
	handle /api/render* {
		reverse_proxy draft:8099 {
			import retry_restart
		}
	}
	# опрос фоновых заданий рендера (01.09): длинный запрос больше не держит соединение
	handle /api/job* {
		reverse_proxy draft:8099 {
			import retry_restart
		}
	}
	handle /api/share* {
		reverse_proxy draft:8099 {
			import retry_restart
		}
	}

	reverse_proxy remlab-app:3000 {
		import retry_restart
	}
}
