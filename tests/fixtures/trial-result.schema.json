{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "units": {
      "type": "string",
      "const": "cm"
    },
    "source": {
      "type": "object",
      "properties": {
        "mime": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ]
        },
        "pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "usedPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "imageW": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "imageH": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mime",
        "pages",
        "usedPages",
        "imageW",
        "imageH"
      ],
      "additionalProperties": false
    },
    "scale": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "listing",
            "not_verified"
          ]
        },
        "ppm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inliers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "ppm",
        "inliers",
        "n"
      ],
      "additionalProperties": false
    },
    "panels": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "rooms": {
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "name": {
                  "type": "string",
                  "maxLength": 80
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "living",
                    "bedroom",
                    "kitchen",
                    "bathroom",
                    "hall",
                    "other"
                  ]
                },
                "contour": {
                  "minItems": 3,
                  "maxItems": 4000,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "d"
                  ],
                  "additionalProperties": false
                },
                "areaM2": {
                  "type": "number",
                  "minimum": 0
                },
                "dims": {
                  "type": "object",
                  "properties": {
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "src": {
                      "type": "string",
                      "enum": [
                        "plan",
                        "listing"
                      ]
                    }
                  },
                  "required": [
                    "w",
                    "d",
                    "src"
                  ],
                  "additionalProperties": false
                },
                "flags": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "contour",
                "bbox",
                "areaM2",
                "flags"
              ],
              "additionalProperties": false
            }
          },
          "walls": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "z0": {
                  "type": "number"
                },
                "z1": {
                  "type": "number"
                },
                "polys": {
                  "maxItems": 400,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "outer": {
                        "minItems": 3,
                        "maxItems": 4000,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        }
                      },
                      "holes": {
                        "maxItems": 200,
                        "type": "array",
                        "items": {
                          "minItems": 3,
                          "maxItems": 4000,
                          "type": "array",
                          "items": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        }
                      }
                    },
                    "required": [
                      "outer",
                      "holes"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "z0",
                "z1",
                "polys"
              ],
              "additionalProperties": false
            }
          },
          "openings": {
            "maxItems": 400,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "door",
                    "window",
                    "opening"
                  ]
                },
                "c": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "widthCm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "exterior": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "c",
                "widthCm",
                "exterior"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "rooms",
          "walls",
          "openings"
        ],
        "additionalProperties": false
      }
    },
    "flags": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "timings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 40
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "units",
    "source",
    "scale",
    "panels",
    "flags",
    "timings",
    "costUsd"
  ],
  "additionalProperties": false
}
